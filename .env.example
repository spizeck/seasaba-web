# =============================================================================
# Sea Saba — environment variables
#
# Copy this file to `.env.local` (git-ignored). Every NEXT_PUBLIC_* value is
# inlined into the public client bundle, and the unprefixed FIREBASE_* values
# are public project identifiers used only by a diagnostic script. The only
# true secret is SENTRY_AUTH_TOKEN — a build-time credential that lives in
# Vercel Production only and is never needed (or wanted) locally.
#
# Local development works with ALL placeholders left as-is: the site starts,
# every page renders, and no analytics tags load. Real values are only needed
# for live /dive-log data (Firebase) and the /cookie-policy declaration widget
# (Cookiebot CBID).
# =============================================================================

# --- Firebase (browser SDK) -------------------------------------------------
# Read by lib/firebase.ts. Optional for local development — leave the
# placeholders and /dive-log simply shows its "unable to load" state while
# every other page works normally. To see live data locally, use your own
# Firebase project's web-app config (Firebase Console > Project Settings >
# General > Your apps). Do not paste production values here unless you are
# specifically debugging production data.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
# Optional — only used if Firebase Analytics is ever initialized (the app does
# not call getAnalytics today); the placeholder is harmless.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Firestore diagnostic script only ----------------------------------------
# Used ONLY by `node scripts/test-public-firestore-read.mjs`, which verifies
# anonymous read access to the dives/sites/species/boats collections on a real
# Firebase project. The Next.js app does not read these. The script does not
# load .env.local itself — export the variables first (see docs/TESTING.md).
# Safe to leave as placeholders for normal development.
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_APP_ID=your_app_id_here

# --- Optional integrations ----------------------------------------------------
# Google Tag Manager container ID. When unset, components/analytics-loader.tsx
# renders nothing — no GTM, GA4, Google Ads, Clarity or Meta tags load and
# nothing is tracked. Leaving it empty is the recommended local default.
# Set the real container ID (GTM-XXXXXXX) only in deployed environments.
NEXT_PUBLIC_GTM_ID=

# Cookiebot Domain Group ID (CBID). Used by the footer "Cookie Settings"
# button and the /cookie-policy declaration script. The CMP itself is deployed
# via the GTM container (docs/COOKIEBOT_CONSENT_SETUP.md). Empty is fine
# locally: the declaration shows a fallback message and the button no-ops.
# Do not guess — copy the real ID from Cookiebot > Settings > Your scripts,
# or leave empty.
NEXT_PUBLIC_COOKIEBOT_CBID=

# Respond.io Website Chat widget cId (public identifier, not a secret — it
# is visible in the page source of any site embedding the widget). When set,
# components/respond-io-widget.tsx injects the native widget script after
# the window load event; when empty, nothing loads and the site has no chat
# launcher. The widget only renders on domains whitelisted in the Respond.io
# channel settings (www.seasaba.com) — other values just fail closed.
NEXT_PUBLIC_RESPOND_IO_CID=

# --- Sentry error monitoring (#129) ------------------------------------------
# Public DSN for the `sea-saba-web` Sentry project. Browser-visible by design
# — a DSN only permits sending error events, it is not a credential. The SDK
# initializes ONLY on real Vercel Production deployments (VERCEL_ENV=production
# is checked in code, separately from this value); everywhere else it is inert
# even if a DSN is present. Set it in Vercel's Production environment only and
# leave it empty locally.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry organization slug, read by the build plugin in next.config.ts.
# Required in the Vercel Production environment for release/source-map upload
# (#130). This is an identifier, not a secret.
SENTRY_ORG=

# Sentry auth token for build-time release creation + source-map upload
# (#130). TRUE SECRET — set in the Vercel Production environment only, never
# commit a real value, and NEVER put it behind a NEXT_PUBLIC_* name (the
# token must stay out of the browser bundle). Leave empty locally: local,
# test and Preview builds never upload. Required scopes: org:read,
# project:releases (an internal integration token or org auth token).
SENTRY_AUTH_TOKEN=

# NOTE: the canonical site URL is NOT an environment variable. It is the
# SITE_URL constant in lib/constants.ts (https://www.seasaba.com) and is the
# same in every environment.
