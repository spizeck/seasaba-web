# Firebase Configuration
# Get these values from your Firebase Console > Project Settings > General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_APP_ID=your_app_id_here

# Public Firebase Configuration (required for browser-side SDK in Next.js)
# These MUST be exposed with the NEXT_PUBLIC_ prefix so the client-side Firebase SDK can connect.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin Configuration (for server-side operations, if used)
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_CLIENT_EMAIL=your_service_account_email_here
FIREBASE_PRIVATE_KEY="REPLACE_WITH_YOUR_FIREBASE_ADMIN_PRIVATE_KEY"

# Google Tag Manager (loads GA4 and marketing tags through GTM)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Cookiebot Consent Management Platform
# Get this from the Cookiebot dashboard: Settings > Your scripts > Domain Group ID.
# The Cookiebot CMP script itself is deployed via the GTM container (see
# docs/COOKIEBOT_CONSENT_SETUP.md), but the CBID is also exposed here so the
# footer "Cookie Settings" button and the /cookie-policy declaration script
# can reference the correct domain group without hardcoding it in source.
# DO NOT guess this value — enter the real ID from the Cookiebot account.
NEXT_PUBLIC_COOKIEBOT_CBID=

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=https://www.seasaba.com
